    <EmbeddedResource Include="../../db/migrations/001_trade_history.sql" LogicalName="TradeHistory.sql" />
    <EmbeddedResource Include="../../db/migrations/002_price_history.sql" LogicalName="PriceHistory.sql" />
  </ItemGroup>
</Project>
